<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="mg400">
    <xacro:include filename="$(find mg400_description)/urdf/mg400.xacro" />

    <xacro:arg name="prefix" default="" />
    <xacro:arg name="use_arm" default="True" />
    <xacro:arg name="workspace_visible" default="false" />

    <link name="world" />
    <joint name="world_fixed_joint" type="fixed">
        <parent link="world" />
        <child link="$(arg prefix)arm_frame_link_offset" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <link name="$(arg prefix)arm_frame_link_offset">
        <inertial>
            <mass value="10.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="0.1 0.1 0.1"/></geometry>
        </collision>
    </link>

    <xacro:mg400
            parent="$(arg prefix)arm_frame_link_offset"
            prefix="$(arg prefix)"
            workspace_visible="$(arg workspace_visible)">
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:mg400>

    <gazebo reference="arm_frame_link_offset">
        <gravity>0</gravity>
       
    </gazebo>
    <gazebo reference="mg400_base_link"><gravity>0</gravity></gazebo>
    <gazebo reference="mg400_link1"><gravity>0</gravity></gazebo>
    <gazebo reference="mg400_link2_1"><gravity>0</gravity></gazebo>
    <gazebo reference="mg400_link2_2"><gravity>0</gravity></gazebo>
    <gazebo reference="mg400_link3_1"><gravity>0</gravity></gazebo>
    <gazebo reference="mg400_link3_2"><gravity>0</gravity></gazebo>
    <gazebo reference="mg400_link4_1"><gravity>0</gravity></gazebo>
    <gazebo reference="mg400_link4_2"><gravity>0</gravity></gazebo>
    <gazebo reference="mg400_link4_3"><gravity>0</gravity></gazebo>
    <gazebo reference="mg400_link5"><gravity>0</gravity></gazebo>
    <gazebo reference="mg400_end_effector_flange"><gravity>0</gravity></gazebo>

   
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>

        <joint name="mg400_j1">
            <command_interface name="position"/>  <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="mg400_j2_1">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="mg400_j2_2">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="mg400_j3_1">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="mg400_j3_2">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="mg400_j4_1">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="mg400_j4_2">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="mg400_j5">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
            <parameters>$(find dobot_gazebo)/config/controllers.yaml</parameters>
        </plugin>
    </gazebo>
</robot>